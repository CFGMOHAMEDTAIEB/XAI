# Copy to .env for local development. Never use these placeholders in production.
APP_ENV=development
POSTGRES_DB=xai
POSTGRES_USER=xai
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD
POSTGRES_PORT=15432
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

API_BIND_ADDRESS=127.0.0.1
API_PORT=18000
ANGULAR_PORT=4200
NEXTJS_PORT=3000
ADMIN_PORT=5050
PGADMIN_PORT=5051
MAILPIT_UI_PORT=18025
MAILPIT_SMTP_PORT=11025

PGADMIN_DEFAULT_EMAIL=local-pgadmin@example.com
PGADMIN_DEFAULT_PASSWORD=REPLACE_WITH_RANDOM_PGADMIN_PASSWORD

CORS_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:5050
PUBLIC_API_URL=http://localhost:18000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:4200

EMAIL_PROVIDER=mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@xai.local
SMTP_SECURITY=none

# Optional development-only users. Keep real values in the ignored .env file.
XAI_DEMO_WEB_EMAIL=web-demo@example.com
XAI_DEMO_WEB_PASSWORD=REPLACE_WITH_RANDOM_WEB_DEMO_PASSWORD
XAI_DEMO_DESKTOP_EMAIL=desktop-demo@example.com
XAI_DEMO_DESKTOP_PASSWORD=REPLACE_WITH_RANDOM_DESKTOP_DEMO_PASSWORD
