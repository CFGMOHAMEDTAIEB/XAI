@if(string.IsNullOrWhiteSpace(Href)){<div class="metric-card @Tone"><span>@Label</span><strong>@Value</strong><small>@Detail</small></div>}
else{<a class="metric-card metric-link @Tone" href="@Href"><span>@Label</span><strong>@Value</strong><small>@Detail</small><b>View details →</b></a>}
@code {[Parameter,EditorRequired]public string Label{get;set;}="";[Parameter,EditorRequired]public string Value{get;set;}="";[Parameter]public string Detail{get;set;}="";[Parameter]public string Tone{get;set;}="blue";[Parameter]public string? Href{get;set;}}
