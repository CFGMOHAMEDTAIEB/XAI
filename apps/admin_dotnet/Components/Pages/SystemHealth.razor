@page "/system"
@page "/system-health"
@inherits AdminReadPage<IReadOnlyList<ServiceHealth>>

<PageTitle>System health | XAICD Admin</PageTitle>
<AdminPageHeader Section="System" Title="System health" Description="Read-only prerequisite checks for core XAICD services.">
    <Actions><button class="button secondary" disabled="@Loading" @onclick="LoadAsync"><XIcon Name="system" /> Refresh</button></Actions>
</AdminPageHeader>

<AdminDataState RequiresLogin="RequiresLogin" Loading="Loading" Error="@Error" OnRetry="LoadAsync">
    @if (Data is not null)
    {
        <div class="service-grid">
            @if (!Data.Any()) { <section class="card grid-full"><AdminEmptyState Icon="system" Title="No service checks available" /></section> }
            @foreach (var service in Data) { <article class="service-card"><span class="service-icon"><XIcon Name="system" /></span><div><span>Prerequisite</span><h2>@service.Name</h2><p>Checked @service.CheckedAt.LocalDateTime.ToString("g")</p></div><StatusBadge Value="@service.Status" /></article> }
        </div>
    }
</AdminDataState>
<div class="info-callout"><XIcon Name="system" /><div><strong>Readiness, not uptime</strong><p>These checks do not measure historical uptime, end-to-end file processing, or provider delivery.</p></div></div>

@code { protected override Task<IReadOnlyList<ServiceHealth>> FetchAsync() => Api.GetHealthAsync(); }
