@page "/login"
@layout AuthLayout
@inject PlatformApiClient Api
@inject AdminSession Session
@inject NavigationManager Navigation

<PageTitle>Sign in | XAI Admin</PageTitle>
<section class="admin-login-card" aria-labelledby="admin-login-title">
    <header class="login-brand">
        <span class="brand-mark" aria-hidden="true">XC</span>
        <span class="login-brand-copy"><strong>XAI-Compress</strong><small>Administration Console</small></span>
    </header>
    @if (!_mfaRequired)
    {
        <div class="login-heading"><p class="eyebrow">Authorized administrators only</p><h1 id="admin-login-title">Welcome back</h1><p>Secure access for authorized administrators.</p></div>
        <form class="admin-login-form" @onsubmit="SignIn" @onsubmit:preventDefault>
            <div class="form-field">
                <label for="admin-email">Email</label>
                <div class="input-with-icon"><XIcon Name="mail" /><input id="admin-email" type="email" @bind="_email" autocomplete="username" disabled="@_busy" required /></div>
            </div>
            <div class="form-field">
                <label for="admin-password">Password</label>
                <div class="password-input-wrap">
                    <XIcon Name="lock" />
                    <input id="admin-password" type="@(_showPassword ? "text" : "password")" @bind="_password" autocomplete="current-password" disabled="@_busy" required />
                    <button type="button" class="password-toggle" aria-label="@(_showPassword ? "Hide password" : "Show password")" aria-pressed="@_showPassword" disabled="@_busy" @onclick="() => _showPassword = !_showPassword"><XIcon Name="@(_showPassword ? "eye-off" : "eye")" /></button>
                </div>
            </div>
            <button class="button primary login-submit" type="submit" disabled="@_busy">@if (_busy) { <span class="button-spinner" aria-hidden="true"></span> }<span>@(_busy ? "Signing in…" : "Sign in")</span></button>
        </form>
    }
    else
    {
        <div class="login-heading"><p class="eyebrow">Additional verification</p><h1 id="admin-login-title">Verify your identity</h1><p>Enter the 6-digit code from XAI Authenticator.</p></div>
        <form class="admin-login-form" @onsubmit="SignIn" @onsubmit:preventDefault>
            <div class="form-field">
                <label for="admin-totp">Authenticator code</label>
                <div class="input-with-icon"><XIcon Name="key" /><input id="admin-totp" class="otp" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" @bind="_totp" disabled="@_busy" autofocus /></div>
            </div>
            <button class="button primary login-submit" type="submit" disabled="@(_busy || _totp.Length != 6)">@if (_busy) { <span class="button-spinner" aria-hidden="true"></span> }<span>@(_busy ? "Verifying…" : "Verify")</span></button>
            <button class="button login-back" type="button" disabled="@_busy" @onclick="Back">Back to sign in</button>
        </form>
    }
    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="login-alert" role="alert"><XIcon Name="warning" /><span>@_error</span></div> }
    <footer class="protected-note"><XIcon Name="security" /><span>Protected administrator access</span></footer>
</section>

@code {
    private string _email = "", _password = "", _totp = "", _error = "";
    private bool _busy, _mfaRequired, _showPassword;
    protected override void OnInitialized() { if (Session.IsAuthenticated) Navigation.NavigateTo("/"); }
    private void Back() { _mfaRequired = false; _totp = ""; _password = ""; _error = ""; }
    private async Task SignIn()
    {
        if (_busy) return; _busy = true; _error = "";
        try { await Api.LoginAsync(_email, _password, _mfaRequired ? _totp : null); _password = ""; _totp = ""; Navigation.NavigateTo("/"); }
        catch (AdminMfaRequiredException) { _mfaRequired = true; _totp = ""; }
        catch (AdminApiAuthorizationException ex) { _error = ex.StatusCode == System.Net.HttpStatusCode.Forbidden ? "Access denied. This account is not authorized for administration." : (_mfaRequired ? "That code was not accepted. Enter the current 6-digit code and try again." : "Sign-in failed. Check your email and password."); if (!_mfaRequired) _password = ""; }
        catch (OperationCanceledException) { _error = "Request timed out. Try again shortly."; }
        catch (HttpRequestException) { _error = "The service is unavailable. Try again shortly."; }
        catch (Exception) { _error = "Sign-in could not be completed. Try again."; }
        finally { _busy = false; }
    }
}
