@page "/login"
@layout AuthLayout
@inject PlatformApiClient Api
@inject AdminSession Session
@inject NavigationManager Navigation

<PageTitle>Sign in | XAICD Admin</PageTitle>
<section class="auth-card" aria-labelledby="auth-title">
    <header class="auth-brand"><span class="brand-mark" aria-hidden="true">XD</span><div><strong>XAICD</strong><span>Administration Console</span></div></header>
    @if (!_mfaRequired && !_enrollmentRequired)
    {
        <div class="auth-heading"><p class="eyebrow">Authorized administrators only</p><h1 id="auth-title">Welcome back</h1><p>Sign in to manage platform operations and security.</p></div>
        <form class="auth-form" @onsubmit="SignIn" @onsubmit:preventDefault>
            <label>Email address<span class="input-shell"><XIcon Name="mail" /><input type="email" @bind="_email" autocomplete="username" disabled="@_busy" required autofocus /></span></label>
            <label>Password<span class="input-shell password-shell"><XIcon Name="lock" /><input type="@(_showPassword ? "text" : "password")" @bind="_password" autocomplete="current-password" disabled="@_busy" required /><button type="button" aria-label="@(_showPassword ? "Hide password" : "Show password")" aria-pressed="@_showPassword" disabled="@_busy" @onclick="() => _showPassword = !_showPassword"><XIcon Name="@(_showPassword ? "eye-off" : "eye")" /></button></span></label>
            <a class="auth-link" href="/forgot-password">Forgot password?</a>
            <button class="button primary auth-submit" type="submit" disabled="@_busy">@if (_busy) { <span class="button-spinner"></span> } @(_busy ? "Signing in…" : "Sign in")</button>
        </form>
    }
    else
    {
        <div class="auth-heading"><p class="eyebrow">@(_enrollmentRequired ? "First-time setup" : "Additional verification")</p><h1 id="auth-title">@(_enrollmentRequired ? "Set up XAICD Authenticator" : "Verify your identity")</h1><p>@(_enrollmentRequired ? "Sign in to the Android authenticator using this account, then enter its current 6-digit code. No QR code is required." : "Enter the current 6-digit code from XAICD Authenticator.")</p></div>
        <form class="auth-form" @onsubmit="SignIn" @onsubmit:preventDefault>
            <label>Authenticator code<span class="input-shell"><XIcon Name="key" /><input class="otp-input" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" @bind="_totp" disabled="@_busy" autofocus /></span></label>
            <button class="button primary auth-submit" type="submit" disabled="@(_busy || _totp.Length != 6)">@if (_busy) { <span class="button-spinner"></span> } @(_busy ? "Verifying…" : "Verify")</button>
            <button class="button secondary auth-submit" type="button" disabled="@_busy" @onclick="Back">Back to sign in</button>
        </form>
    }
    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="auth-alert" role="alert"><XIcon Name="warning" /><span>@_error</span></div> }
    <footer class="auth-protected"><XIcon Name="security" /><span>Authorized administrators only</span></footer>
</section>

@code {
    private string _email = "", _password = "", _totp = "", _error = "";
    private bool _busy, _mfaRequired, _enrollmentRequired, _showPassword;
    protected override void OnInitialized()
    {
        if (Session.IsAuthenticated) { Navigation.NavigateTo("/dashboard", replace: true); return; }
        if (Session.State == AdminSessionState.Expired && new Uri(Navigation.Uri).Query.Contains("expired=1", StringComparison.OrdinalIgnoreCase))
            _error = "Your administrator session has expired. Please sign in again.";
    }
    private void Back() { _mfaRequired = false; _enrollmentRequired = false; _totp = ""; _password = ""; _error = ""; Api.ClearPending(); }
    private async Task SignIn()
    {
        if (_busy) return; _busy = true; _error = "";
        try
        {
            if (_mfaRequired) await Api.VerifyMfaAsync(_totp);
            else if (_enrollmentRequired) await Api.ConfirmEnrollmentAsync(_totp);
            else await Api.LoginAsync(_email, _password);
            _password = ""; _totp = ""; Navigation.NavigateTo("/dashboard", replace: true);
        }
        catch (AdminMfaRequiredException) { _mfaRequired = true; _totp = ""; }
        catch (AdminEnrollmentRequiredException) { _enrollmentRequired = true; _password = ""; _totp = ""; }
        catch (AdminApiAuthorizationException ex) { _error = ex.StatusCode == System.Net.HttpStatusCode.Forbidden ? "Access denied. This account is not authorized for administration." : (_mfaRequired || _enrollmentRequired ? "Invalid verification code. Please try again." : "Sign-in failed. Check your email and password."); if (!_mfaRequired) _password = ""; }
        catch (OperationCanceledException) { _error = "The request timed out. Try again shortly."; }
        catch (HttpRequestException) { _error = "The service is unavailable. Try again shortly."; }
        catch (Exception) { _error = "Sign-in could not be completed. Try again."; }
        finally { _busy = false; }
    }
}
