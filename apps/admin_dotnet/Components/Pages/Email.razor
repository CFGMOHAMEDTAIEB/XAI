@page "/email"
@inherits AdminReadPage<EmailConfiguration>

<PageTitle>Email delivery | XAICD Admin</PageTitle>
<AdminPageHeader Section="System" Title="Email delivery" Description="Safe configuration status for transactional account and administrator email.">
    <Actions><button class="button secondary" disabled="@Loading" @onclick="LoadAsync"><XIcon Name="system" /> Refresh</button></Actions>
</AdminPageHeader>

<AdminDataState RequiresLogin="RequiresLogin" Loading="Loading" Error="@Error" OnRetry="LoadAsync">
    @if (Data is not null)
    {
        <section class="card detail-card">
            <header class="card-header"><div><span class="card-kicker">Configuration</span><h2>@Data.Provider</h2></div><StatusBadge Value="@(Data.Configured ? "Configured" : "Not configured")" /></header>
            <dl class="detail-grid"><div><dt>Mode</dt><dd>@(Data.DevelopmentOnly ? "Local development" : "Production adapter")</dd></div><div><dt>Sender</dt><dd>@(Data.SenderConfigured ? "Configured" : "Not configured")</dd></div><div><dt>Transport security</dt><dd>@(Data.SmtpSecurity ?? "Provider managed")</dd></div><div><dt>XAIC attachments</dt><dd>@(Data.XaicSupported ? "Supported" : "Not supported")</dd></div></dl>
        </section>
        @if (Data.Missing.Length > 0) { <div class="alert error" role="alert"><strong>Configuration incomplete.</strong> Missing or invalid: @string.Join(", ", Data.Missing)</div> }
        @if (Data.DevelopmentOnly) { <div class="info-callout"><XIcon Name="mail" /><div><strong>Local delivery mode</strong><p>Mailpit captures development messages locally and does not deliver production email.</p></div></div> }
    }
</AdminDataState>
<div class="info-callout"><XIcon Name="lock" /><div><strong>No message is sent by this page</strong><p>Configured credentials do not prove delivery. Provider secrets stay on the backend and are never returned here.</p></div></div>

@code { protected override Task<EmailConfiguration> FetchAsync() => Api.GetEmailConfigurationAsync(); }
