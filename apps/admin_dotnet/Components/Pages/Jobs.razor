@page "/jobs"
@inherits AdminReadPage<IReadOnlyList<CompressionJob>>
<PageTitle>Files and compression jobs</PageTitle>
<div class="page-heading"><div><h1>Files and compression jobs</h1><p>Stored file records, modes, sizes and integrity flags. This is not a live worker queue.</p></div><button disabled="@Loading" @onclick="LoadAsync">Refresh</button></div>
<AdminDataState RequiresLogin="RequiresLogin" Loading="Loading" Error="Error">
@if(Data is not null){<section class="panel"><table><thead><tr><th>Job</th><th>File</th><th>User</th><th>Mode</th><th>Status</th><th>Sizes</th><th>Integrity</th></tr></thead><tbody>
@if(Data.Count==0){<tr><td colspan="7">No file records yet.</td></tr>}
@foreach(var job in Data){<tr><td>@job.Id</td><td><strong>@job.FileName</strong><small>@job.CreatedAt.LocalDateTime</small></td><td>@job.UserEmail</td><td>@job.Mode</td><td><StatusBadge Value="@job.Status" /></td><td>@Format(job.OriginalSize) &rarr; @Format(job.CompressedSize)</td><td>@(job.IntegrityVerified?"Verified":"Not verified")</td></tr>}
</tbody></table></section>}
</AdminDataState>
@code {
 protected override Task<IReadOnlyList<CompressionJob>> FetchAsync()=>Api.GetJobsAsync();
 private static string Format(long x)=>$"{x/1024d:F1} KiB";
}
