@page "/audit"
@inherits AdminReadPage<IReadOnlyList<AuditEvent>>
<PageTitle>Audit logs</PageTitle>
<div class="page-heading"><div><h1>Audit trail</h1><p>Recorded administrative, authentication, sharing and file events. This is not a complete incident feed.</p></div><button disabled="@Loading" @onclick="LoadAsync">Refresh</button></div>
<AdminDataState RequiresLogin="RequiresLogin" Loading="Loading" Error="Error">
@if(Data is not null){<section class="panel"><table><thead><tr><th>Time</th><th>Actor</th><th>Action</th><th>Resource</th><th>Result</th><th>Source</th></tr></thead><tbody>
@if(Data.Count==0){<tr><td colspan="6">No audit events recorded.</td></tr>}
@foreach(var item in Data){<tr><td>@item.CreatedAt.LocalDateTime</td><td>@item.Actor</td><td class="mono">@item.Action</td><td>@item.Resource</td><td><StatusBadge Value="@item.Result" /></td><td>@item.IpAddress</td></tr>}
</tbody></table></section>}
</AdminDataState>
@code { protected override Task<IReadOnlyList<AuditEvent>> FetchAsync()=>Api.GetAuditAsync(); }
