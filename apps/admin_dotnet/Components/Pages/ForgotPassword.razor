@page "/forgot-password"
@layout AuthLayout
@inject PlatformApiClient Api

<PageTitle>Reset password | XAICD Admin</PageTitle>
<section class="auth-card" aria-labelledby="recovery-title">
    <header class="auth-brand"><span class="brand-mark" aria-hidden="true">XD</span><div><strong>XAICD</strong><span>Administration Console</span></div></header>
    <div class="auth-heading"><p class="eyebrow">Account recovery</p><h1 id="recovery-title">@(_step == RecoveryStep.Complete ? "Password updated" : "Reset your password")</h1><p>@StepDescription</p></div>
    @if (_step == RecoveryStep.Email)
    {
        <form class="auth-form" @onsubmit="RequestReset" @onsubmit:preventDefault><label>Email address<span class="input-shell"><XIcon Name="mail" /><input type="email" @bind="_email" autocomplete="email" disabled="@_busy" required autofocus /></span></label><button class="button primary auth-submit" type="submit" disabled="@_busy">@(_busy ? "Sending…" : "Send reset instructions")</button></form>
    }
    else if (_step == RecoveryStep.Code)
    {
        <div class="neutral-message" role="status">If an account exists for this email, password reset instructions have been sent.</div>
        <form class="auth-form" @onsubmit="VerifyCode" @onsubmit:preventDefault><label>Email code<span class="input-shell"><XIcon Name="key" /><input class="otp-input" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" @bind="_code" disabled="@_busy" required autofocus /></span></label><button class="button primary auth-submit" type="submit" disabled="@(_busy || _code.Length != 6)">Verify code</button><button class="button secondary auth-submit" type="button" disabled="@_busy" @onclick="StartOver">Use another email</button></form>
    }
    else if (_step == RecoveryStep.Password)
    {
        <form class="auth-form" @onsubmit="ResetPassword" @onsubmit:preventDefault><label>New password<span class="input-shell"><XIcon Name="lock" /><input type="password" @bind="_newPassword" autocomplete="new-password" minlength="10" disabled="@_busy" required /></span></label><label>Confirm new password<span class="input-shell"><XIcon Name="lock" /><input type="password" @bind="_confirmation" autocomplete="new-password" minlength="10" disabled="@_busy" required /></span></label><button class="button primary auth-submit" type="submit" disabled="@_busy">@(_busy ? "Updating…" : "Reset password")</button></form>
    }
    else { <a class="button primary auth-submit" href="/login">Return to sign in</a> }
    @if (!string.IsNullOrWhiteSpace(_error)) { <div class="auth-alert" role="alert"><XIcon Name="warning" /><span>@_error</span></div> }
    @if (_step != RecoveryStep.Complete) { <a class="auth-back-link" href="/login">Back to sign in</a> }
    <footer class="auth-protected"><XIcon Name="security" /><span>Protected administrator access</span></footer>
</section>

@code {
    private enum RecoveryStep { Email, Code, Password, Complete }
    private RecoveryStep _step;
    private string _email = "", _code = "", _newPassword = "", _confirmation = "", _error = "";
    private string? _resetToken;
    private bool _busy;
    private string StepDescription => _step switch { RecoveryStep.Email => "Enter your administrator email address.", RecoveryStep.Code => "Enter the 6-digit code from your reset email.", RecoveryStep.Password => "Choose a new password for your account.", _ => "You can now sign in with your new password. Your authenticator is still required." };
    private void StartOver() { _step = RecoveryStep.Email; _code = _newPassword = _confirmation = _error = ""; _resetToken = null; }
    private async Task RequestReset() { if (_busy) return; _busy = true; _error = ""; try { await Api.RequestPasswordResetAsync(_email.Trim()); _step = RecoveryStep.Code; } catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException) { _error = "Reset instructions could not be requested right now. Please try again."; } finally { _busy = false; } }
    private async Task VerifyCode() { if (_busy) return; _busy = true; _error = ""; try { _resetToken = await Api.VerifyPasswordResetCodeAsync(_email.Trim(), _code); _code = ""; _step = RecoveryStep.Password; } catch (AdminRecoveryInvalidException) { _error = "Invalid or expired code. Check the email and try again."; } catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException) { _error = "The code could not be verified right now. Please try again."; } finally { _busy = false; } }
    private async Task ResetPassword()
    {
        if (_busy) return; if (_newPassword != _confirmation) { _error = "Passwords do not match."; return; } if (System.Text.Encoding.UTF8.GetByteCount(_newPassword) > 72) { _error = "Password is too long."; return; } if (string.IsNullOrWhiteSpace(_resetToken)) { StartOver(); return; }
        _busy = true; _error = "";
        try { await Api.ResetPasswordAsync(_resetToken, _newPassword); _step = RecoveryStep.Complete; }
        catch (AdminRecoveryInvalidException) { _error = "Reset authorization expired. Request new instructions."; _resetToken = null; _step = RecoveryStep.Email; }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException) { _error = "The password could not be updated right now. Please try again."; }
        finally { _busy = false; _newPassword = _confirmation = ""; if (_step == RecoveryStep.Complete) _resetToken = null; }
    }
}
