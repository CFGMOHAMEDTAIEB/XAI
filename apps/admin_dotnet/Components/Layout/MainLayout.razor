@inherits LayoutComponentBase
@implements IDisposable
@inject PlatformApiClient Api
@inject AdminSession Session
@inject NavigationManager Navigation
@inject IWebHostEnvironment HostEnvironment

<div class="app-shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-mark">XC</div>
            <div>
                <strong>XAI-Compress</strong>
                <span>Security Console</span>
            </div>
        </div>
        <NavMenu />
        <div class="sidebar-footer">
            <div class="environment-dot"></div>
            <div>
                <strong>@HostEnvironment.EnvironmentName</strong>
                <small>Server environment; readiness checked separately</small>
            </div>
        </div>
    </aside>
    <main class="main-content">
        <header class="topbar">
            <div>
                <strong>Administration</strong>
                <span>Monitor users, security, files and compression jobs</span>
            </div>
            <div class="admin-profile">
                @if (Session.IsAuthenticated) { <button disabled="@_signingOut" @onclick="Logout">Logout</button> }
                <div><strong>@(Session.IsAuthenticated ? "Admin session" : "Not signed in")</strong><small>API authorization required for protected data</small></div>
            </div>
        </header>
        <section class="page-content">
            @Body
        </section>
    </main>
</div>

@code {
    protected override void OnInitialized() => Session.Changed += SessionChanged;
    private void SessionChanged() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Session.Changed -= SessionChanged;
    private bool _signingOut;
    private async Task Logout() {
        if (_signingOut) return;
        _signingOut = true;
        try { await Api.LogoutAsync(); Navigation.NavigateTo("/login"); }
        finally { _signingOut = false; }
    }
}
