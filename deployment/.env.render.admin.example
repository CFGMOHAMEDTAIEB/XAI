# render.admin deployment. Replace placeholders; never commit real secrets.
ASPNETCORE_ENVIRONMENT=Production
# Used by: render.admin
# Example: Production
# Secret: no
# Required: yes

ASPNETCORE_URLS=http://+:8080
# Used by: render.admin
# Example: http://+:8080
# Secret: no
# Required: yes

PORT=8080
# Used by: render.admin
# Example: 8080
# Secret: no
# Required: yes

PlatformApi__BaseUrl=https://REPLACE_API.onrender.com
# Used by: render.admin
# Example: https://REPLACE_API.onrender.com
# Secret: no
# Required: yes

PlatformApi__UseDemoFallback=false
# Used by: render.admin
# Example: false
# Secret: no
# Required: yes

Authentication__OidcEnabled=false
# Used by: render.admin
# Example: false
# Secret: no
# Required: yes

Authentication__RequireHttpsMetadata=true
# Used by: render.admin
# Example: true
# Secret: no
# Required: yes

PortalUrl=https://REPLACE_PORTAL.vercel.app
# Used by: render.admin
# Example: https://REPLACE_PORTAL.vercel.app
# Secret: no
# Required: yes

