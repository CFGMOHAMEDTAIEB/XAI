APP_ENV=production
# Used by: FastAPI startup validation
# Example: production
# Secret: no
# Required: yes

# render.api deployment. Replace placeholders; never commit real secrets.
DATABASE_URL=postgresql+psycopg://REPLACE_DB_USER:REPLACE_URL_ENCODED_DB_PASSWORD@REPLACE_INTERNAL_DB_HOST:5432/REPLACE_DB_NAME
# Used by: render.api
# Example: provider-issued secret, never committed
# Secret: yes
# Required: yes

JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHIC_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Used by: render.api
# Example: provider-issued secret, never committed
# Secret: yes
# Required: yes

ACCESS_TOKEN_MINUTES=15
# Used by: render.api
# Example: 15
# Secret: no
# Required: yes

REFRESH_TOKEN_DAYS=30
# Used by: render.api
# Example: 30
# Secret: no
# Required: yes

SHARE_CODE_MINUTES=60
# Used by: render.api
# Example: 60
# Secret: no
# Required: yes

PUBLIC_BASE_URL=https://xai-usg.vercel.app
# Used by: render.api
# Example: https://REPLACE_PUBLIC_SITE.vercel.app
# Secret: no
# Required: yes

CORS_ORIGINS=https://xai-usg.vercel.app
# Used by: render.api
# Example: https://REPLACE_PORTAL.vercel.app,https://REPLACE_PUBLIC_SITE.vercel.app
# Secret: no
# Required: yes

ADMIN_EMAILS=REPLACE_ADMIN_EMAIL
# Used by: render.api
# Example: REPLACE_ADMIN_EMAIL
# Secret: no
# Required: no

STORAGE_PATH=/data
# Used by: render.api
# Example: /data
# Secret: no
# Required: yes

SELECTOR_MODEL_PATH=/opt/xai-compress/checkpoints/selector_v2/best.json
# Used by: render.api
# Example: /opt/xai-compress/checkpoints/selector_v2/best.json
# Secret: no
# Required: yes

MAX_UPLOAD_BYTES=1073741824
# Used by: render.api
# Example: 1073741824
# Secret: no
# Required: yes

MAX_DECOMPRESSED_BYTES=1073741824
# Used by: render.api
# Example: 1073741824
# Secret: no
# Required: yes

PORT=10000
# Used by: render.api
# Example: 10000
# Secret: no
# Required: yes

SMTP_HOST=smtp-relay.brevo.com
# Used by: render.api
# Example: smtp-relay.brevo.com
# Secret: no
# Required: only for EMAIL_PROVIDER=smtp

SMTP_PORT=587
# Used by: render.api
# Example: 587
# Secret: no
# Required: only for EMAIL_PROVIDER=smtp

SMTP_FROM=REPLACE_AUTHORIZED_SENDER_EMAIL
# Used by: render.api
# Example: REPLACE_AUTHORIZED_SENDER_EMAIL
# Secret: no
# Required: yes

SMTP_USERNAME=REPLACE_SMTP_USERNAME
# Used by: render.api
# Example: REPLACE_SMTP_USERNAME
# Secret: no
# Required: only for EMAIL_PROVIDER=smtp

SMTP_PASSWORD=REPLACE_SMTP_PASSWORD_OR_APP_PASSWORD
# Used by: render.api
# Example: provider-issued secret, never committed
# Secret: yes
# Required: only for EMAIL_PROVIDER=smtp

SMTP_SECURITY=starttls
# Used by: render.api
# Example: starttls
# Secret: no
# Required: only for EMAIL_PROVIDER=smtp

SMTP_TIMEOUT_SECONDS=30
# Used by: render.api
# Example: 30
# Secret: no
# Required: yes

SMTP_MAX_ATTACHMENT_BYTES=18000000
# Used by: render.api
# Example: 18000000
# Secret: no
# Required: yes

EMAIL_PROVIDER=brevo
# Used by: render.api
# Example: brevo
# Secret: no
# Required: yes

BREVO_API_KEY=REPLACE_BREVO_API_KEY
# Used by: render.api
# Example: provider-issued secret, never committed
# Secret: yes
# Required: only for EMAIL_PROVIDER=brevo

# Private scanner service discovery; provision this private service before deployment.
SECURITY_SCAN_REQUIRED=true
# Copy the real host (without :3310) from the Render private service Connect menu.
# Compose's hostname 'clamav' is not a Render service discovery guarantee.
CLAMAV_HOST=REPLACE_WITH_RENDER_PRIVATE_HOST
CLAMAV_PORT=3310
SECURITY_SCAN_TIMEOUT=60
# Project defensive baseline; rebuild backend after reviewed rule changes.
YARA_RULES_PATH=/app/security/yara/production
MAX_HEAVY_REQUESTS=2
MIN_FREE_DISK_BYTES=1073741824
UPLOAD_IDLE_TIMEOUT=30
UPLOAD_TOTAL_TIMEOUT=300

