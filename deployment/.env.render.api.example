# Application
APP_ENV=production
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
SHARE_CODE_MINUTES=60
MAX_UPLOAD_BYTES=1073741824
MAX_DECOMPRESSED_BYTES=1073741824
MAX_HEAVY_REQUESTS=2
MIN_FREE_DISK_BYTES=1073741824
UPLOAD_IDLE_TIMEOUT=30
UPLOAD_TOTAL_TIMEOUT=300
SELECTOR_MODEL_PATH=/opt/xai-compress/checkpoints/selector_v2/best.json

# Authentication
JWT_SECRET=REPLACE_WITH_A_NEW_CRYPTOGRAPHIC_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_EMAILS=OPTIONAL_COMMA_SEPARATED_ADMIN_CONTACT_EMAILS
# Enable only for the documented one-time administrator bootstrap; remove afterward.
XAI_SEED_ADMIN=false
XAI_SEED_ADMIN_EMAIL=OPTIONAL_BOOTSTRAP_ADMIN_EMAIL
XAI_SEED_ADMIN_PASSWORD=OPTIONAL_BOOTSTRAP_PASSWORD

# Database
DATABASE_URL=postgresql+psycopg://REPLACE_URL_ENCODED_USER:REPLACE_URL_ENCODED_PASSWORD@REPLACE_RENDER_INTERNAL_HOST:5432/REPLACE_DATABASE

# Email
EMAIL_PROVIDER=brevo
BREVO_API_KEY=REPLACE_BREVO_TRANSACTIONAL_API_KEY
BREVO_SENDER_EMAIL=REPLACE_VERIFIED_SENDER_EMAIL
BREVO_SENDER_NAME=XAI_Compress
# SMTP variables are required only when EMAIL_PROVIDER=smtp or mailpit.
SMTP_HOST=REPLACE_SMTP_HOST_IF_SMTP_SELECTED
SMTP_PORT=587
SMTP_USERNAME=REPLACE_SMTP_USERNAME_IF_SMTP_SELECTED
SMTP_PASSWORD=REPLACE_SMTP_PASSWORD_IF_SMTP_SELECTED
SMTP_FROM=REPLACE_SMTP_SENDER_EMAIL_IF_SMTP_SELECTED
SMTP_FROM_NAME=XAI_Compress
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=30
SMTP_MAX_ATTACHMENT_BYTES=18000000
# Resend variables are required only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=REPLACE_RESEND_API_KEY_IF_RESEND_SELECTED
RESEND_FROM_EMAIL=REPLACE_VERIFIED_RESEND_SENDER_IF_RESEND_SELECTED

# Security scanners
SECURITY_SCAN_REQUIRED=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
SECURITY_SCAN_TIMEOUT=60
YARA_RULES_PATH=/app/security/yara/production

# Storage
STORAGE_PATH=/data

# CORS / public URLs
CORS_ORIGINS=https://REPLACE_PORTAL_ORIGIN,https://REPLACE_PUBLIC_SITE_ORIGIN,https://REPLACE_ADMIN_ORIGIN
PUBLIC_BASE_URL=https://REPLACE_PUBLIC_SITE_ORIGIN

# Authenticator / Push
# QR enrollment, TOTP, device public keys, Ed25519 signatures, number matching,
# recovery-code hashes, and authentication history use the existing database and JWT_SECRET.
# Do not add device private keys to this service. No push-provider variables exist yet.
