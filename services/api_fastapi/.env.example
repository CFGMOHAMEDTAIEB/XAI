DATABASE_URL=sqlite:///./xai_platform.db
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
SHARE_CODE_MINUTES=60
PUBLIC_BASE_URL=http://localhost:8000

# MFA verification email (backend only; supply the key via the secret environment).
EMAIL_PROVIDER=brevo
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Backend transactional email sender (verified in Brevo)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=XAI Compress
BREVO_API_KEY=

# Explicit CLI-only bootstrap; no account is seeded at API startup.
XAI_SEED_ADMIN=false
XAI_SEED_ADMIN_EMAIL=
XAI_SEED_ADMIN_PASSWORD=
SMTP_FROM_NAME=XAI Compress
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=30
APP_ENV=development
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
SECURITY_SCAN_REQUIRED=true
SECURITY_SCAN_TIMEOUT=60
# Blank selects the environment-specific bundled directory.
YARA_RULES_PATH=
